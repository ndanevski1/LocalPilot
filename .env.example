# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN="your_bot_token_here"
# Required for normal use. If empty, the bot runs in locked-down setup mode
# (it only tells you your Telegram ID). Never leave this empty in production.
TELEGRAM_ALLOWED_USER_ID="your_telegram_numeric_user_id"

# "production" refuses to start without TELEGRAM_ALLOWED_USER_ID
LOCALPILOT_ENV="development"

# Browser agent safety policy for state-changing actions (clicks on buttons, form typing).
# Comma-separated sites where such actions may be requested for approval. Empty = none allowed.
LOCALPILOT_ALLOWED_SITES=""
# Maximum purchase amount the agent may request approval for. 0 = no purchases.
LOCALPILOT_SPEND_LIMIT="0"
LOCALPILOT_CURRENCY="USD"
